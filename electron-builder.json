{
  "appId": "com.mediafactory.app",
  "productName": "MediaFactory",
  "directories": {
    "output": "dist-release"
  },
  "asar": true,
  "asarUnpack": [
    "m7-astrofox/app/**/*"
  ],
  "files": [
    "dist/**/*",
    "backend/**/*",
    "!backend/bin/**/*",
    "!backend/ffmpeg/**/*",
    "electron/main.cjs",
    "electron/**/*",
    "src/**/*",
    "m7-astrofox/app/**/*",
    "node_modules/**/*",
    "package.json",
    "!dummy.mp4",
    "!test_bg.mp4",
    "!test_audio.mp3"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "allowElevation": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "differentialPackage": true
  },
  "extraFiles": [
    {
      "from": "backend/bin",
      "to": "bin",
      "filter": [
        "**/*"
      ]
    }
  ],
  "extraResources": [
    {
      "from": "backend/bin",
      "to": "backend/bin",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "backend/bin",
      "to": "bin",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "m7-astrofox/app",
      "to": "m7-astrofox/app",
      "filter": [
        "**/*"
      ]
    }
  ]
}
