{
  "name": "mediafactory",
  "private": true,
  "version": "1.0.27",
  "description": "MediaFactory Desktop App",
  "author": "MediaFactory",
  "repository": {
    "type": "git",
    "url": "https://github.com/synclimit/MediaFactory.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:serve": "cross-env NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:publish": "npm run build && electron-builder -p always"
  },
  "build": {
    "appId": "com.mediafactory.app",
    "productName": "MediaFactory",
    "asar": false,
    "files": [
      "dist/**/*",
      "backend/**/*",
      "electron/main.cjs",
      "electron/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "dummy.mp4",
      "test_bg.mp4",
      "test_audio.mp3"
    ],
    "directories": {
      "output": "dist-release"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "compression": "store",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "differentialPackage": true
    },
    "extraResources": [
      {
        "from": "backend/bin",
        "to": "backend/bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/ffmpeg",
        "to": "backend/ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "synclimit",
        "repo": "MediaFactory"
      }
    ]
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tailwindcss/vite": "^4.3.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.18.1",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.21.0",
    "puppeteer": "^25.1.0",
    "puppeteer-core": "^25.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
